# =============================================================================
# 环境变量模板（可入库）
# 复制为 .env 并替换为真实值：cp .env.example .env
# 真实 .env 文件请勿提交到代码仓库
# =============================================================================

# ----- MySQL 数据库 -----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=diet
MYSQL_USER=root
MYSQL_PASSWORD=

# ----- Redis 缓存 -----
REDIS_HOST=localhost
REDIS_PORT=6379

# ----- 微信小程序登录 -----
WX_APPID=
WX_SECRET=

# ----- JWT 鉴权（至少 32 字符的强随机密钥）-----
JWT_SECRET=
